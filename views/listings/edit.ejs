<% layout("layouts/boilerplate") %>
<div class="edit-page-body">

<h2 class="page-title text-center">Edit Your Stay</h2>

<p class="page-subtitle">
    Update your property details below.
</p>

<div class="container mt-5 mb-0">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <form method="POST" action="/listings/<%= listing._id %>?_method=PUT">

                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input
                        type="text"
                        id="title"
                        name="listing[title]"
                        value="<%= listing.title %>"
                        class="form-control">
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea
                        id="description"
                        name="listing[description]"
                        class="form-control"
                        rows="4"><%= listing.description %></textarea>
                </div>

                <div class="row">

                    <div class="col-md-3 mb-3">
                        <label for="price" class="form-label">Price</label>
                        <input
                            type="number"
                            id="price"
                            name="listing[price]"
                            value="<%= listing.price %>"
                            class="form-control">
                    </div>

                    <div class="col-md-9 mb-3">
                        <label for="image" class="form-label">Image URL</label>
                        <input
                            type="text"
                            id="image"
                            name="listing[image]"
                            value="<%= listing.image.url %>"
                            class="form-control">
                    </div>

                </div>

                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input
                        type="text"
                        id="location"
                        name="listing[location]"
                        value="<%= listing.location %>"
                        class="form-control">
                </div>

                <div class="mb-4">
                    <label for="country" class="form-label">Country</label>
                    <input
                        type="text"
                        id="country"
                        name="listing[country]"
                        value="<%= listing.country %>"
                        class="form-control">
                </div>

                <button class="btn btn-success">
                    Update Listing
                </button>

            </form>

        </div>

    </div>

</div>
</div>


<%# action-Where should I send the form data after the user clicks Submit?%>
<%# The browser knows that whatever the user types in this input belongs to the key country because of the name="country" 
attribute. When the form is submitted, Express receives it as req.body.country.%>
<%# The value attribute shows the current (existing) value inside the input box. value takes priority over placeholder. %>