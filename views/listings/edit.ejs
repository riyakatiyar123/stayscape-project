<% layout("layouts/boilerplate") %>

<div class="edit-page-body">

    <h2 class="page-title text-center">Edit Your Stay</h2>

    <p class="page-subtitle">
        Update your property details below.
    </p>

    <div class="container mt-5 mb-0">

        <div class="row justify-content-center">

            <div class="col-lg-7">

                <form method="POST"
                      action="/listings/<%= listing._id %>?_method=PUT"
                      class="needs-validation"
                     novalidate
                     enctype="multipart/form-data">

                    <!-- Title -->
                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>

                        <input
                            type="text"
                            id="title"
                            name="listing[title]"
                            value="<%= listing.title %>"
                            class="form-control"
                            required>

                        <div class="invalid-feedback">
                            Please enter a title.
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>

                        <textarea
                            id="description"
                            name="listing[description]"
                            class="form-control"
                            rows="4"
                            required><%= listing.description %></textarea>

                        <div class="invalid-feedback">
                            Please enter a description.
                        </div>
                    </div>
                   <div class="mb-2">
    <img
        src="<%= listing.image.url %>"
        alt="Current Image"
        style="
            width: 250px;
            height: 180px;
            display: block;
            margin: 0;
            padding: 0;
            object-fit: contain;
            
        ">
</div>

                    <!-- Price & Image -->
                    <div class="row">

                        <div class="col-md-3 mb-3">
                            <label for="price" class="form-label">Price</label>

                            <input
                                type="number"
                                id="price"
                                name="listing[price]"
                                value="<%= listing.price %>"
                                class="form-control"
                                required>

                            <div class="invalid-feedback">
                                Please enter the price.
                            </div>
                        </div>
                        
                        <div class="col-md-9 mb-3">
                            <label for="image" class="form-label">Upload new Image</label>

                            <input
                                type="file"
                                id="image"
                                name="listing[image]"
                                class="form-control"
                                placeholder="Image URL"
                                >

                            <!-- No required here because your schema has a default image -->
                        </div>

                    </div>

                    <!-- Location -->
                    <div class="mb-3">
                        <label for="location" class="form-label">Location</label>

                        <input
                            type="text"
                            id="location"
                            name="listing[location]"
                            value="<%= listing.location %>"
                            class="form-control"
                            required>

                        <div class="invalid-feedback">
                            Please enter the location.
                        </div>
                    </div>

                    <!-- Country -->
                    <div class="mb-4">
                        <label for="country" class="form-label">Country</label>

                        <input
                            type="text"
                            id="country"
                            name="listing[country]"
                            value="<%= listing.country %>"
                            class="form-control"
                            required>

                        <div class="invalid-feedback">
                            Please enter the country.
                        </div>
                    </div>

                    <button class="btn btn-success">
                        Update Listing
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


<%# action-Where should I send the form data after the user clicks Submit?%>
<%# The browser knows that whatever the user types in this input belongs to the key country because of the name="country" 
attribute. When the form is submitted, Express receives it as req.body.country.%>
<%# The value attribute shows the current (existing) value inside the input box. value takes priority over placeholder. %>