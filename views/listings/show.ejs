<% layout("layouts/boilerplate") %>

<div class="show-body">

    <h3 class="mb-4"><%= listing.title %></h3>

    <div class="card show-card">
        <img
            src="<%= listing.image.url %>"
            class="card-img-top show-img"
            alt="listing_image">

        <div class="card-body">
            <p class="card-text"><%= listing.title %></p>
        </div>
    </div>

    <div class="mt-4">
        <h4>Details</h4>

        <ul class="list-unstyled">
            <li><%= listing.description %></li>
            <li>&#8377; <%= listing.price.toLocaleString("en-IN") %></li>
            <li><%= listing.location %></li>
            <li><%= listing.country %></li>
        </ul>
    </div>

    <div class="d-flex gap-3 mt-3">

        <a
            href="/listings/<%= listing._id %>/edit"
            class="btn show-btn">
            Edit
        </a>

        <form
            method="POST"
            action="/listings/<%= listing._id %>?_method=DELETE">

            <button class="btn show-btn">
                Delete
            </button>

        </form>

    </div>

    <!-- Review Form -->

    <div class="container mt-5 mb-5">

        <div class="card shadow-sm border-0 p-4">

            <h4 class="text-center mb-4">
                Leave a Review
            </h4>

            <form action="/listings/<%= listing.id%>/reviews" method="POST" class="needs-validation" novalidate>

               <fieldset class="starability-basic">

                    <legend>Rating</legend>

                    <input type="radio" id="rate5" name="review[rating]" value="5">
                    <label for="rate5" title="Amazing">5 stars</label>

                    <input type="radio" id="rate4" name="review[rating]" value="4">
                    <label for="rate4" title="Very Good">4 stars</label>

                    <input type="radio" id="rate3" name="review[rating]" value="3">
                    <label for="rate3" title="Average">3 stars</label>

                    <input type="radio" id="rate2" name="review[rating]" value="2">
                    <label for="rate2" title="Poor">2 stars</label>

                    <input type="radio" id="rate1" name="review[rating]" value="1" checked>
                    <label for="rate1" title="Terrible">1 star</label>

                </fieldset>

                <div class="mb-4 mt-3">

                    <label for="comment" class="form-label">
                        Comments
                    </label>

                    <textarea
    id="comment"
    name="review[comment]"
    class="form-control"
    rows="5"
    placeholder="Share your experience..."
    required></textarea>
                    <div class="invalid-feedback">

    Please enter a comment.

</div>
                        

                </div>

                <div class="text-center">

                    <button class="btn show-btn">
                        Submit Review
                    </button>

                </div>

            </form>

        </div>


       <h4>All the Reviews</h4>
        <div class="row"> 
            <% for(let review of listing.reviews){
            %>
            <div class="listing-card col-5 mb-3 ms-3">
                <div class="card-body">
                    <h5 class="card-title">joe dany</h5>
                    <p class="card-text"><%= review.comment%></p>
                     <p class="card-text"><%= review.rating%> star</p>
                     <form class="mb-3" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id%>?_method=DELETE">
                        <button>Delete</button>
                      
                     </form>

                </div>
                 
            </div>
<%}%>
        </div>
      