<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Staysacpe</title>
</head>
<body>
    
    <% layout("layouts/boilerplate") %>
    <h2>All listings</h2>
   
     <%for(let listing of allListings)
    {%> 
    <div class="card" style="width: 22rem;">
  <img src="<%= listing.image.url%>" class="card-img-top" alt="listing_image">
  <div class="card-body">
    <h5 class="card-title">Card title</h5>
    <p class="card-text"><%= listing.title %>
    <br>
  &#8377;  <%= listing.price.toLocaleString("en-IN") %> / night
</p>
    <a href="#" class="btn btn-primary">Go somewhere</a>
  </div>
</div>
     <%}%>


 <ul>
<%for(let listing of allListings)
{%>
 <li>  <a  href="/listings/<%= listing._id %>"><%= listing.title %></a> </li>  <%# MongoDB automatically creates an _id field for every document you save. We use listing._id to create a unique URL for each listing. %>
<%}%>
</ul>
</body>
</html>

