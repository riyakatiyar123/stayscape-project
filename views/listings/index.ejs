

<% layout("layouts/boilerplate") %>
<%= success %>

<!-- <h2>All Listings</h2> -->
<div id="filters">

   <a href="/listings?category=Trending">
    <div class="filter">
        <i class="fa-solid fa-fire"></i>
        <p>Trending</p>
    </div>
</a>

    <a href="/listings?category=Amazing Views">
    <div class="filter">
        <i class="fa-solid fa-mountain-sun"></i>
        <p>Amazing views</p>
    </div>

   <a href="/listings?category=Pools">
    <div class="filter">
        <i class="fa-solid fa-person-swimming"></i>
        <p>Pools</p>
    </div>
</a>

    <a href="/listings?category=Beachfront">
    <div class="filter">
        <i class="fa-solid fa-umbrella-beach"></i>
        <p>Beachfront</p>
    </div>
</a>

    <a href="/listings?category=Treehouses">
    <div class="filter">
       <i class="fa-solid fa-tree"></i>
        <p>Treehouses</p>
    </div>

    <a href="/listings?category=Camping">
    <div class="filter">
        <i class="fa-solid fa-campground"></i>
        <p>Camping</p>
    </div>

    <a href="/listings?category=Historical">
    <div class="filter">
       <i class="fa-solid fa-landmark"></i>
        <p>Historical</p>
    </div>
</a>
</div>
<% if(allListings.length === 0){ %>

<div class="no-results">
    <h2>No Listings Found 😕</h2>

    <p>
        Sorry! We couldn't find any stays
        <% if(searchLocation){ %>
            in "<strong><%= searchLocation %></strong>"
        <% } %>.
    </p>

    <p>Please try searching for another location.</p>

    <a href="/listings" class="btn btn-primary mt-3">
         Back to All Stays
    </a>
</div>

<% } else { %>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">

    <% for(let listing of allListings) { %>

    <div class="col">

        <div class="card h-100">

            <a href="/listings/<%= listing._id %>" class="listing-link">

                <img
                    src="<%= listing.image.url %>"
                    class="card-img-top"
                    alt="listing image"
                >

                <div class="card-body">

                    <h5 class="card-title">
                        <b><%= listing.title %></b>
                    </h5>

                    <p class="card-text">
                        ₹ <%= listing.price.toLocaleString("en-IN") %> / night
                    </p>

                </div>

            </a>

            <div class="card-footer bg-transparent border-0">
                <a href="/listings/<%= listing._id %>" class="btn btn-primary">
                    View Details
                </a>
            </div>

        </div>

    </div>

    <% } %>

</div>

<% } %>

</body>
</html>