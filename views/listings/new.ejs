<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stayscape</title>
</head>
<body>
    <h2>enter details of the listing</h2>
    <form method="POST" action="/listings">
       <input type="text" name="listing[title]" placeholder="Enter the name">
       <br><br>
       <textarea name="listing[description]" placeholder="enter the description"></textarea>
       <br><br>
       <input type="number" name="listing[price]" placeholder="Enter the price">
       <br><br>
       <input type="text" name="listing[image]" placeholder="Enter the image/URL">
       <br><br>
       <input type="text" name="listing[location]" placeholder="Enter the location">
       <br><br>
       <input type="text" name="listing[country]" placeholder="Enter the country">
       <br><br>
       <button>submit</button>
    </form>
</body>
</html>